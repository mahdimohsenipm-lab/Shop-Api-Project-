{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {

    "SqlServer": "Server=.;Database=MyApiDb;Trusted_Connection=True;TrustServerCertificate=True;"

  },

  "SiteSettings": {
    "ElmahPath": "/elmah-errors",
    "JwtSettings": {
      "SecretKey": "MySecretKeyMahdiMohseniKerahrodi",
      "Issuer": "MyWebsite",
      "Audience": "MyWebsite",
      "NotBeforeMinutes": 0,
      "ExpirationMinutes": 60,
      "Encryptkey": "MySecretKeyMahdi"
    },
    "IdentitySetting": {
      "RequireUniqueEmail": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequiredLength": 6

    }

  }
}

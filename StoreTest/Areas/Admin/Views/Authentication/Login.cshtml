@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود</title>
    <link href="~/sitetamplate/css/stylelogin.css" rel="stylesheet" />
</head>
<body>
    <div class="login-box">
        <h2>ورود به حساب کاربری</h2>
        <form id="loginForm">
            <div class="input-group">
                <label>ایمیل</label>
                <input type="email" id="Email" name="Email" placeholder="example@email.com" required />
            </div>
            <div class="input-group">
                <label>رمز عبور</label>
                <input type="password" id="Password" name="Password" placeholder="********" required />
            </div>
            <button type="button" onclick="Login()">ورود</button>
            <div class="extra">
                فکرشو نمی‌کردی نه؟
            </div>
        </form>
    </div>
    <a href="~/lib/jquery/dist/jquery.min.map"></a>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>

    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>
    <script>
            function Login() {
                var Email = $("#Email").val();
                var Password = $("#Password").val();
        var postData = {
                    Email: Email,
                    Password: Password
                };
        $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    type: 'POST',
                    url: 'Login',
                    data: JSON.stringify(postData),
                    success: function (data) {
                        if (data.isSuccess === true) {
                            Swal.fire(
                                'موفق!',
                                data.message || 'ورود با موفقیت انجام شد.',
                                'success'
                            ).then(function () {
                                window.location.replace('/Admin/AdminUser/index');
                            });
                        } else {
                            if (data.message === "عدم دسترسی") {
                                Swal.fire(
                                    'خطا!',
                                    data.message,
                                    'error'
                                ).then(function () {
                                    window.location.replace('/Admin/Authentication/AccessDenied');
                                });
                            } else {
                                Swal.fire(
                                    'هشدار!',
                                    data.message || 'عملیات انجام نشد.',
                                    'warning'
                                );
                            }
                        }
                    },
                    error: function (request) {
                        var response = request.responseJSON;
        if (response && response.message === "عدم دسترسی") {
                            Swal.fire(
                                'خطا!',
                                response.message,
                                'error'
                            ).then(function () {
                                window.location.replace('/Admin/Authentication/AccessDenied');
                            });
                        } else {
                            Swal.fire(
                                'هشدار!',
                                (response && response.message) || 'عملیات انجام نشد.',
                                'warning'
                            );
                        }
                    }
                });
            }
    </script>


</body>
</html>


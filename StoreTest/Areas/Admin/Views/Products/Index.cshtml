@using X.PagedList
@using X.PagedList.Mvc.Core
@using Services.ViewModel.Area.Model.Request
@model RequestProductDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}




<div class="content-wrapper">
    <div class="container-fluid">
        <!-- Zero configuration table -->
        <section id="configuration">
            <div class="row">
                <div class="col-12">
                    <div class="card">

                        <div class="card-body collapse show">
                            <div class="card-block card-dashboard">
                                <p class="card-text">لیست محصولات</p>
                                <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                                    <div class="col-sm-12">
                                        <table class="table table-striped table-bordered zero-configuration dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                            <thead>
                                                <tr role="row">
                                                    <th class="sorting_asc">نام</th>
                                                    <th class="sorting_asc">برند </th>

                                                    <th class="sorting_asc">موجودی</th>

                                                    <th class="sorting_asc">قیمت </th>
                                                    <th class="sorting_asc">نمایش در سایت؟ </th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @foreach (var item in Model.Products)
                                                {
                                                    <tr role="row">
                                                        <td>@item.Name  


                                                        </td>
                                                        <td>@item.Brand</td>
                                                        <td>@item.Inventory</td>
                                                        <td class="PriceProduct">@item.Price.ToString("n0")
                                                        <input type="hidden" id="RealPrice" value="@item.Price" /></td>
                                                        <td>@item.Displayed</td>
                                                        <td>
                                                            <a onclick="ShowModalEdituser('@item.Id' , '@item.Name',@item.Price,@item.Inventory)" class="btn btn-info">ویرایش</a>
                                                            <a onclick="DeleteUser(@item.Id)" class="btn btn-danger">حذف</a>
                                                            <a href="~/admin/products/Detail/@item.Id" class="btn btn-info">اطلاعات بیشتر</a>
                                                             @if (item.IsDiscount==true)
                                                            {
                                                            <a href="~/Admin/Discount/Detail/@item.Id" class="btn btn-secondary">اطلاعات تخفیف</a>
                                                                
                                                            }
                                                            @if (item.IsDiscount==false)
                                                            {
                                                                      <button type="button"
                                                        class="btn btn-info"
                                                         data-toggle="modal"
                                                         data-target="#discountModal"
                                                         onclick="openDiscountModal('@item.Id', '@item.Name')">
                                                        اعمال تخفیف
                                                        </button>
                                                            }
                                                 

                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="  text-center">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="card-footer bg-white border-top">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
<!-- بخش آمار با متن رابط مناسب -->
        <div class="text-muted small py-2">
            نمایش 
            <span class="badge bg-light text-dark border">@Model.Products.FirstItemOnPage</span> 
            تا 
            <span class="badge bg-light text-dark border">@Model.Products.LastItemOnPage</span> 
            از مجموع 
            <span class="text-primary fw-bold">@Model.Products.TotalItemCount</span> 
            رکورد ثبت شده
        </div>
<!-- بخش دکمه‌های صفحه‌بندی -->
        <nav aria-label="Page navigation">
            @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page }), 
                new PagedListRenderOptions {
                    LiElementClasses = new string[] { "page-item" },
                    PageClasses = new string[] { "page-link" },
                    UlElementClasses = new string[] { "pagination", "pagination-sm", "mb-0" },
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    LinkToFirstPageFormat = "« ابتدا",
                    LinkToLastPageFormat = "انتها »",
                    LinkToNextPageFormat = "بعدی",
                    LinkToPreviousPageFormat = "قبلی",
                    // این گزینه باعث می‌شود اگر کلاً ۱ صفحه داشتیم، بخش صفحه‌بندی مخفی شود
                    Display = PagedListDisplayMode.IfNeeded 
                })
        </nav>
</div>
</div>


@section Scripts
{
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

    <script>


     


        function DeleteUser(id) {
                swal.fire({
                    title: 'حذف کاربر',
                    text: "کاربر گرامی از حذف کاربر مطمئن هستید؟",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#7cacbe',
                    confirmButtonText: 'بله ، کاربر حذف شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        var postData = {
                            'id': id,
                        };

                        $.ajax({
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            type: "POST",
                            url: "Delete",
                            data: postData,
                            success: function (data) {
                                if (data.isSuccess == true) {
                                    swal.fire(
                                        'موفق!',
                                        data.message,
                                        'success'
                                    ).then(function (isConfirm) {
                                        location.reload();
                                    });
                                }
                                else {

                                    swal.fire(
                                        'هشدار!',
                                        data.message,
                                        'warning'
                                    );

                                }
                            },
                            error: function (request, status, error) {
                                alert(request.responseText);
                            }

                        });

                    }
                })
            }



                 function Edituser() {

                    var id = $("#Edit_UserId").val();
                    var Name = $("#Edit_Fullname").val();
                    var Price = $("#Edit_Price").val();
                    var Inventory = $("#Edit_Inventory").val();


            var postData = {
                Id: id,
                Name: Name,
                Inventory: Inventory,
                Price: Price
              };

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "Update",
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {
                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }
                    });

                    $('#EditUser').modal('hide');

                }

                                 function ShowModalEdituser(Id, Name,Price,Inventory) {
                                    $('#Edit_Fullname').val(Name)
                                    $('#Edit_UserId').val(Id)
                                    $('#Edit_Price').val(Price)
                                    $('#Edit_Inventory').val(Inventory)

                                    $('#EditUser').modal('show');

                                }





                                ////////////discountModals

                                function openDiscountModal(Id, Name) {
    $('#productId').val(Id);
    $('#productName').val(Name);

                                } 

$(document).ready(function () {

    function toggleDiscountFields() {
        if ($('#discountAmountRadio').is(':checked')) {
            $('#amount').prop('disabled', false);
            $('#percentage').prop('disabled', true).val('');
        } else {
            $('#percentage').prop('disabled', false);
            $('#amount').prop('disabled', true).val('');
        }
    }



    // وقتی مودال باز شد
    $('#discountModal').on('shown.bs.modal', function () {
        toggleDiscountFields();
    });

    // تغییر نوع تخفیف
    $(document).on('change', 'input[name="discountType"]', function () {
        toggleDiscountFields();
    });

    // ثبت تخفیف
    window.submitDiscount = function () {
        const productId = $('#productId').val();
        const endTime = $('#endTime').val();
        const isAmount = $('#discountAmountRadio').is(':checked');

        const PriceProduct = parseInt($("#RealPrice").val(), 10);

        alert(PriceProduct);
        const localDateTime = new Date(endTime);
        const utcDateTimeString = localDateTime.toISOString();
        let amount = null;
        let percentage = null;


        if (isAmount) {
           amount = parseInt($('#amount').val(), 10);
            if (amount>=PriceProduct)
            {
                alert('مبلغ وارد شده باید کمتر از مبلغ محصول باشه');

                return;
            }


            if (!amount || parseFloat(amount) <= 0) {
                alert('لطفاً مبلغ تخفیف معتبر وارد کنید.');
                return;
            }
        } else {
            percentage = $('#percentage').val();
            if (!percentage || parseFloat(percentage) <= 0 || parseFloat(percentage) > 100) {
                alert('لطفاً درصد تخفیف معتبر بین 1 تا 100 وارد کنید.');
                return;
            }
        }

        if (!productId) {
            alert('شناسه محصول مشخص نیست.');
            return;
        }


        if (!endTime) {
            alert('لطفاً تاریخ پایان را وارد کنید.');
            return;
        }

        const formData = {
            productId: productId,
            amount: amount,
            percentage: percentage,
            endTime: utcDateTimeString
        };

        console.log(formData);

        $.ajax({
              contentType: 'application/x-www-form-urlencoded',
            dataType: 'json',
            type: 'POST',
            url: '/Admin/Products/AddDiscount',
               data: formData,
            success: function (data) {
                if (data.isSuccess === true) {
                    swal.fire('موفق!', data.message, 'success').then(function () {
                        $('#discountModal').modal('hide');
                        location.reload();
                    });
                } else {
                    swal.fire('هشدار!', data.message, 'warning');
                }
            },
            error: function (request) {
                alert(request.responseText);
            }
        });
    };

    // در شروع، فیلدها را تنظیم کن
    toggleDiscountFields();
});



    </script>
}



@section Modals
{

    <div class="modal fade" id="EditUser" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">ویرایش محصول</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                        <fieldset class="form-group">
                            <input type="hidden" id="Edit_UserId" />
                            <label for="basicInput">نام </label>
                            <input type="text" class="form-control" id="Edit_Fullname">
                        </fieldset>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                        <fieldset class="form-group">
                            <label for="basicInput">قیمت</label>
                            <input type="text" class="form-control" id="Edit_Price">
                        </fieldset>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="col-xl-12 col-lg-12 col-md-12 mb-1">
                        <fieldset class="form-group">
                            <label for="basicInput">موجودی</label>
                            <input type="text" class="form-control" id="Edit_Inventory">
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-secondary" data-dismiss="modal">بستن</a>
                    <a class="btn btn-primary" onclick="Edituser()">اعمال تغییرات</a>
                </div>
            </div>
        </div>
    </div>
}


@section DiscountModals
{

    <!-- Modal -->
    <div class="modal fade" id="discountModal" tabindex="-1" role="dialog" aria-labelledby="discountModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

          <!-- Header -->
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title" id="discountModalLabel">
              ثبت تخفیف برای محصول: <span id="modalProductName"></span>
            </h5>
            <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>

          <!-- Body -->
          <div class="modal-body">
            <form id="discountForm">

              <!-- ProductId (Hidden input) -->
              <input type="hidden" id="productId" name="productId" value="">

              <!-- Product Name Display -->
              <div class="form-group">
                <label>نام محصول</label>
                <input type="text" class="form-control" id="productName" readonly>
              </div>

              <!-- Discount Type Selection -->
<div class="form-group d-flex align-items-center flex-wrap">
    <label class="mb-0 ml-3">نوع تخفیف</label>

    <div class="form-check form-check-inline mb-0 ml-3">
        <input class="form-check-input" type="radio"
               name="discountType" id="discountAmountRadio"
               value="amount" checked>
        <label class="form-check-label" for="discountAmountRadio">مبلغی</label>
    </div>

    <div class="form-check form-check-inline mb-0">
        <input class="form-check-input" type="radio"
               name="discountType" id="discountPercentageRadio"
               value="percentage">
        <label class="form-check-label" for="discountPercentageRadio">درصدی</label>
    </div>
</div>



              <!-- Amount -->
              <div class="form-group">
                <label for="amount">مبلغ تخفیف (تومان)</label>
                <input type="number" class="form-control" id="amount" name="amount" placeholder="مثلاً 50000">
              </div>

              <!-- Percentage -->
              <div class="form-group">
                <label for="percentage">درصد تخفیف (%)</label>
                <input type="number" class="form-control" id="percentage" name="percentage" placeholder="مثلاً 20" disabled>
              </div>

              <!-- EndTime -->
              <div class="form-group">
                <label for="endTime">تاریخ پایان</label>
                <input type="datetime-local" class="form-control" id="endTime" name="endTime">
              </div>

            </form>
          </div>

          <!-- Footer -->
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">
              انصراف
            </button>
            <button type="button" class="btn btn-success" onclick="submitDiscount()">
              ذخیره
            </button>
          </div>

        </div>
      </div>
    </div>
}



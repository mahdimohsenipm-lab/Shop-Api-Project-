@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}
<div class="uc-wrapper">
    <div class="uc-card">
        <h2 class="uc-title">Create User</h2>
        <div class="uc-form-group">
            <label class="uc-label" for="UserName">UserName</label>
            <input type="text" id="UserName" name="UserName" class="uc-input" placeholder="MahdiMohseni" pattern="[a-zA-Z0-9]+"
                   title="لطفاً فقط حروف انگلیسی و اعداد وارد کنید" required />
        </div>
        <div class="uc-form-group">
            <label class="uc-label" for="UserName">FullName</label>
            <input type="text" id="FullName" name="FullName" class="uc-input" placeholder="مهدی محسنی" required />
        </div>
        <div class="uc-form-group">
            <label class="uc-label" for="Email">Email</label>
            <input type="email" id="Email" name="Email" class="uc-input" required />
        </div>
        <div class="uc-form-group">
            <label class="uc-label" for="PasswordHash">Password</label>
            <input type="password" id="PasswordHash" name="PasswordHash" class="uc-input" required />
        </div>
        <div class="uc-form-group">
            <label class="uc-label" for="Age">Age</label>
            <input type="number" id="Age" name="Age" class="uc-input" min="1" />
        </div>
        <select id="RoleId" name="RoleId" asp-items="ViewBag.Roles" class="form-control">
            <option value="">-- انتخاب نقش --</option>
        </select>

        <div class="uc-form-group uc-checkbox-group mt-2">
            <label class="uc-checkbox-label">
                <input id="IsActive" type="checkbox" name="IsActive" class="uc-checkbox" />
                Is Active
            </label>
        </div>
        <div class="uc-actions">
            <button type="button" class="uc-btn-primary" onclick="Registeruser()">Create</button>
            <button type="reset" class="uc-btn-secondary">Reset</button>
        </div>
    </div>
</div>

@section Scripts
{
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

<script>
            

        function Registeruser() {
        console.log("Registeruser started");
        var userName = $("#UserName").val().trim();
                        var fullName = $("#FullName").val().trim();

        var email = $("#Email").val().trim();
        var passwordHash = $("#PasswordHash").val().trim();
        var ageValue = $("#Age").val().trim();
        var isActive = $("#IsActive").is(":checked");
        var roleIdValue = $("#RoleId").val();
        var age = parseInt(ageValue);
        var roleId = parseInt(roleIdValue);







                var englishReg = /^[a-zA-Z0-9]+$/;
        if (!englishReg.test(userName)) {
        
            Swal.fire({
                icon: "error",
                title: "خطا",
                text: "UserName باید فقط شامل حروف انگلیسی و اعداد باشد",
                confirmButtonText: "متوجه شدم"
            });
     
            return ;
        }

var errors = [];
if (!userName) {
            errors.push("نام کاربری را وارد کنید.");
        } else if (userName.length < 3) {
            errors.push("نام کاربری باید حداقل 3 کاراکتر باشد.");
        }
if (!email) {
            errors.push("ایمیل را وارد کنید.");
                   }
                           if (!fullName) {
                    errors.push("نام را وارد کنید");
                           }
if (!passwordHash) {
            errors.push("رمز عبور را وارد کنید.");
        } else if (passwordHash.length < 6) {
            errors.push("رمز عبور باید حداقل 6 کاراکتر باشد.");
        }
if (!ageValue) {
            errors.push("سن را وارد کنید.");
        } else if (isNaN(age) || age <= 0) {
            errors.push("سن باید یک عدد معتبر بزرگ‌تر از صفر باشد.");
        }
if (!roleIdValue || isNaN(roleId) || roleId <= 0) {
            errors.push("لطفاً نقش کاربر را انتخاب کنید.");
        }
if (errors.length > 0) {
            Swal.fire({
                icon: "warning",
                title: "خطا در ورود اطلاعات",
                html: errors.map(function (e) { return "• " + e; }).join("<br>"),
                confirmButtonText: "باشه"
            });
            return;
        }
Swal.fire({
            title: "ثبت کاربر",
            text: "آیا از ثبت این کاربر اطمینان دارید؟",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "بله، ثبت شود",
            cancelButtonText: "انصراف"
        }).then(function (result) {
            console.log("Swal result:", result);
if (result.isConfirmed || result.value) {
                console.log("confirmed, sending ajax...");
var $btn = $("#btnRegister");
                $btn.prop("disabled", true);
$.ajax({
                    url: "/Admin/AdminUser/Create",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        UserName: userName,
                        Email: email,
                        PasswordHash: passwordHash,
                        Age: age,
                        IsActive: isActive,
                        RoleId: roleId,
                        FullName:fullName
                    }),
                    success: function (response) {
                        console.log("AJAX success:", response);
Swal.fire({
                            icon: "success",
                            title: "موفق",
                            text: "کاربر با موفقیت ثبت شد.",
                            confirmButtonText: "باشه"
                        }).then(function () {
                                         window.location.href = "/Admin/AdminUser/Index";
                                });
                    },
                    error: function (xhr, status, error) {
                        console.log("AJAX error");
                        console.log("status:", status);
                        console.log("error:", error);
                        console.log("responseText:", xhr.responseText);
var message = "ثبت کاربر با خطا مواجه شد.";
if (xhr.responseText) {
                            message = xhr.responseText;
                        }
Swal.fire({
                            icon: "error",
                            title: "خطا",
                            text: message,
                            confirmButtonText: "متوجه شدم"
                        });
                    },
                    complete: function () {
                        $btn.prop("disabled", false);
                    }
                });
            }
        });
    }
</script>


}

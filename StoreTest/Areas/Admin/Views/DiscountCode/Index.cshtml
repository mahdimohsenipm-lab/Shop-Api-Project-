@using X.PagedList
@using X.PagedList.Mvc.Core
@using Services.ViewModel.Area.Model.Dto
@model IPagedList<DiscountCodeDto>

@{
    ViewData["Title"] = "RequestPay";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}


<div class="container-fluid mt-4">

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                لیست کدهای تخفیف
            </h4>

            <a href="/Admin/DiscountCode/AddDiscountCode"
               class="btn btn-success">
                افزودن کد تخفیف
            </a>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="thead-dark">
                    <tr>
                        <th>کد</th>
                        <th>تعداد</th>
                        <th>سقف خرید</th>
                        <th>تخفیف</th>
                        <th>زمان</th>
                        <th>وضعیت</th>
                        <th>باقیمانده</th>
                        <th>عملیات</th>
                    </tr>
                    </thead>

                    <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {

                            var rowClass = "";

                       switch (item.Status)
{
    case DiscountCodeStatus.Active:
        rowClass = "table-success";
        break;

    case DiscountCodeStatus.NotStarted:
        rowClass = "table-warning";
        break;

    case DiscountCodeStatus.Expired:
        rowClass = "table-danger";
        break;

    case DiscountCodeStatus.Disabled:
        rowClass = "table-secondary";
        break;

    case DiscountCodeStatus.Finished:
        rowClass = "table-dark";
        break;
}

                            <tr class="@rowClass">

                                <td>
                                    <strong>@item.Code</strong>
                                </td>

                                <td>
                                    @item.Count
                                </td>

                                <td>
                                    @item.LimitPrice.ToString("N0")
                                    تومان
                                </td>

                                <td>

                                    @if (item.Percentage.Value==0)
                                    {
                                        <span class="badge badge-info">
                                            @item.Amount.Value.ToString("N0") تومان
                                        </span>
                                    }
                                    else if (item.Amount.Value==0)
                                    {
                                        <span class="badge badge-primary">
                                            @item.Percentage%
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>

                                <td class="text-right">

                                    <small>

                                        <b>شروع:</b>

                                        @item.StartTime.ToString("yyyy/MM/dd HH:mm")

                                        <br />

                                        <b>پایان:</b>

                                        @item.EndTime.ToString("yyyy/MM/dd HH:mm")

                                    </small>

                                </td>

                                <td>
@switch (item.Status)
{
    case DiscountCodeStatus.Active:

        <span class="badge badge-success">
            @item.StatusText
        </span>

        break;

    case DiscountCodeStatus.NotStarted:

        <span class="badge badge-warning">
            @item.StatusText
        </span>

        break;

    case DiscountCodeStatus.Expired:

        <span class="badge badge-danger">
            @item.StatusText
        </span>

        break;

    case DiscountCodeStatus.Disabled:

        <span class="badge badge-secondary">
            @item.StatusText
        </span>

        break;

    case DiscountCodeStatus.Finished:

        <span class="badge badge-dark">
            @item.StatusText
        </span>

        break;
}

                                </td>

                              <td>

@if (item.RemainingTime.HasValue)
{
    <span class="badge badge-light border">

        @item.RemainingTimeText

        <br />

        @{
            var time = item.RemainingTime.Value;
        }

        <small>
            @time.Days روز
            @time.Hours ساعت
            @time.Minutes دقیقه
        </small>

    </span>
}
else
{
    <span>-</span>
}

</td>

                                <td>

<button type="button"
        class="btn btn-warning btn-sm"
        data-id="@item.Id"
        data-code="@item.Code"
        data-limitprice="@item.LimitPrice"
        data-amount="@item.Amount"
        data-percentage="@item.Percentage"
        onclick="ShowEditModal(this)">
    ویرایش
</button>

                                    <button class="btn btn-danger btn-sm"
                                            onclick="Delete(@item.Id)">
                                        حذف
                                    </button>

     <button class="btn btn-info btn-sm"
            data-id="@item.Id"
            onclick="discountCodeModal(this)">
        تمدید 
    </button>

@if (item.Status == DiscountCodeStatus.Active)
{
    <button class="btn btn-outline-danger btn-sm"
            data-id="@item.Id"
            onclick="Activat(this)">
        غیرفعال کردن
    </button>
                                        }
                                        else
                                        {

<button class="btn btn-outline-success btn-sm"
          data-id="@item.Id"
          onclick="Activat(this)">
      فعال کردن
  </button>

                                            
                                        }


                                </td>

                            </tr>

                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8">
                                هیچ کد تخفیفی یافت نشد.
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


        <div class="card-footer bg-white border-top-0">
            <div class="pagination-container">
                <div class="text-muted small">
                    نمایش @Model.FirstItemOnPage تا @Model.LastItemOnPage از @Model.TotalItemCount رکورد
                </div>
<nav aria-label="Page navigation">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }), 
                        new PagedListRenderOptions {
                            LiElementClasses = new string[] { "page-item" },
                            PageClasses = new string[] { "page-link" },
                            UlElementClasses = new string[] { "pagination", "pagination-sm", "mb-0" },
                            ContainerDivClasses = new string[] { "pagination-container" },
                            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                            DisplayLinkToLastPage = PagedListDisplayMode.Always,
                            LinkToFirstPageFormat = "« ابتدا",
                            LinkToLastPageFormat = "انتها »",
                             Display = PagedListDisplayMode.IfNeeded 
                        })
                </nav>
            </div>
        </div>


 @section Scripts
{

    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

    <script>

        
  function Delete(Id) {
            swal.fire({
                title: 'حذف کد تخفیف',
                text: "کاربر گرامی از حذف  مطمئن هستید؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7cacbe',
                confirmButtonText: 'بله ،  حذف شود',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.value) {
                    var postData = {
                        'Id': Id,
                    };

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "/Admin/DiscountCode/Delete",
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {

                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );

                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }

                    });

                }
            })
        }



          function StatusChange(Id) {
            swal.fire({
                title: 'تغییر وضعیت کد تخفیف',
                text: "کاربر گرامی از تغییر وضعیت  مطمئن هستید؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7cacbe',
                confirmButtonText: 'بله ، تغییر وضعیت انجام شود',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.value) {

                    var postData = {
                        'Id': Id,
                    };

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "SatusChange",
                        data: postData,
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {

                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );

                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }

                    });

                }
            })
        }
        

function Renew() {

    const model = {
        Id: $("#DiscountCodeId").val(),
        StartTime: $("#StartTime").val(),
        EndTime: $("#EndTime").val(),
        Count: $("#Count").val()
    };

    if (!model.StartTime || !model.EndTime) {
        Swal.fire({
            icon: "warning",
            title: "توجه",
            text: "زمان شروع و پایان را وارد کنید."
        });
        return;
    }

    if (new Date(model.StartTime) >= new Date(model.EndTime)) {
        Swal.fire({
            icon: "warning",
            title: "توجه",
            text: "زمان پایان باید بعد از زمان شروع باشد."
        });
        return;
    }

    const count = parseInt(model.Count);

    if (isNaN(count) || count <= 0) {
        Swal.fire({
            icon: "warning",
            title: "توجه",
            text: "تعداد کدها باید بیشتر از صفر باشد."
        });
        return;
    }

    $.ajax({
        url: "/Admin/DiscountCode/Renew",
        type: "POST",
        data: model,

        beforeSend: function () {
            $("#btnRenew").prop("disabled", true);
        },

        success: function (data) {

            if (data.isSuccess) {

                Swal.fire({
                    icon: "success",
                    title: "موفق",
                    text: data.message
                }).then(() => {
                    location.reload();
                });

            } else {

                Swal.fire({
                    icon: "warning",
                    title: "هشدار",
                    text: data.message
                });
            }
        },

        error: function (xhr) {

            Swal.fire({
                icon: "error",
                title: "خطا",
                text: xhr.responseText || "خطایی در ارتباط با سرور رخ داد."
            });
        },

        complete: function () {
            $("#btnRenew").prop("disabled", false);
        }
    });
}

function discountCodeModal(btn) {

    const id = $(btn).data("id");

    $("#DiscountCodeId").val(id);

    $("#discountCodeModal").modal("show");
}






 function Activat(button) {
            swal.fire({
                title: 'تغییر وضعیت کاربر',
                text: "کاربر گرامی از تغییر وضعیت کاربر مطمئن هستید؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7cacbe',
                confirmButtonText: 'بله ، تغییر وضعیت انجام شود',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.value) {

                    var id = $(button).data("id");

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: "POST",
                        url: "/Admin/DiscountCode/Activation",
                        data: {
            Id: id
        },
                        success: function (data) {
                            if (data.isSuccess == true) {
                                swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function (isConfirm) {
                                    location.reload();
                                });
                            }
                            else {

                                swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );

                            }
                        },
                        error: function (request, status, error) {
                            alert(request.responseText);
                        }

                    });

                }
            })
        }

      
        $(function () {
    $("input[name='DiscountType']").on("change", function () {

   
        if ($("#DiscountAmount").is(":checked")) {

            $("#EditAmount").prop("disabled", false);
            $("#EditPercentage").prop("disabled", true);

        } else {

            $("#EditPercentage").prop("disabled", false);
            $("#EditAmount").prop("disabled", true);

        }

    });

});

function ShowEditModal(btn) {

    var amount = parseInt($(btn).data("amount")) || 0;
    var percentage = parseInt($(btn).data("percentage")) || 0;

    $("#EditId").val($(btn).data("id"));
    $("#EditCode").val($(btn).data("code"));
    $("#EditLimitPrice").val($(btn).data("limitprice"));

    $("#EditAmount").val(amount);
    $("#EditPercentage").val(percentage);

    if (amount > 0) {
    $("#DiscountAmount").prop("checked", true);
} else {
    $("#DiscountPercentage").prop("checked", true);
}

ToggleDiscountFields();

    $("#editDiscountModal").modal("show");
   
}

function UpdateDiscount() {

    var amount = parseInt($("#EditAmount").val()) || 0;
    var percentage = parseInt($("#EditPercentage").val()) || 0;

    // هر دو خالی
    if (amount <= 0 && percentage <= 0) {

        Swal.fire({
            icon: "warning",
            title: "توجه",
            text: "یکی از مقادیر مبلغ یا درصد تخفیف را وارد کنید."
        });

        return;
    }

    // هر دو پر
    if (amount > 0 && percentage > 0) {

        Swal.fire({
            icon: "warning",
            title: "توجه",
            text: "فقط یکی از مقادیر مبلغ یا درصد می‌تواند وارد شود."
        });

        return;
    }

    var model = {

        Id: $("#EditId").val(),
        Code: $("#EditCode").val(),
        LimitPrice: $("#EditLimitPrice").val(),
        Amount: amount,
        Percentage: percentage

    };

    $.ajax({

        url: "/Admin/DiscountCode/Edit",
        type: "POST",
        data: model,

        success: function (result) {

            if (result.isSuccess) {

                $("#editDiscountModal").modal("hide");

                Swal.fire({
                    icon: "success",
                    title: "موفق",
                    text: result.message
                }).then(function () {
                    location.reload();
                });

            } else {

                Swal.fire({
                    icon: "error",
                    title: "خطا",
                    text: result.message
                });

            }

        }

    });

}


function ToggleDiscountFields() {

    if ($("#DiscountAmount").is(":checked")) {

        $("#EditAmount").prop("disabled", false);

        $("#EditPercentage")
            .val(0)
            .prop("disabled", true);

    } else {

        $("#EditPercentage").prop("disabled", false);

        $("#EditAmount")
            .val(0)
            .prop("disabled", true);

    }
}

$(document).on("change", "input[name='DiscountType']", ToggleDiscountFields);
 
</script>
}


@section Modals

{


 
<div class="modal fade" id="discountCodeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">فعال سازی مجدد</h5>
                   <button type="button" class="close" data-dismiss="modal" aria-label="Close">
    <span aria-hidden="true">&times;</span>
</button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">زمان شروع</label>
                    <input type="datetime-local" class="form-control" id="StartTime">
                </div>

                <div class="mb-3">
                    <label class="form-label">زمان پایان</label>
                    <input type="datetime-local" class="form-control" id="EndTime">
                </div>

                <div class="mb-3">
                    <label class="form-label">تعداد کد تخفیف</label>
                    <input type="number" class="form-control" id="Count" min="1" value="1">
                </div>

                <input type="hidden" id="DiscountCodeId" />

            </div>

            <div class="modal-footer">
               <button type="button" class="btn btn-secondary" data-dismiss="modal">
    انصراف
</button>
                <button class="btn btn-success" onclick="Renew()" >ایجاد</button>
            </div>

        </div>
    </div>
</div>
}
    

 @section DiscountModals
{


<div class="modal fade" id="editDiscountModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">ویرایش کد تخفیف</h5>

                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="EditId" />

                <div class="form-group">
                    <label>کد تخفیف</label>
                    <input type="text"
                           id="EditCode"
                           class="form-control"
                           maxlength="8" />
                </div>

                <div class="form-group">
                    <label>حداقل مبلغ خرید</label>
                    <input type="number"
                           id="EditLimitPrice"
                           class="form-control" />
                </div>

<div class="form-group">

    <label>نوع تخفیف</label>

    <div class="d-flex">

        <div class="form-check mr-4">

            <input class="form-check-input"
                   type="radio"
                   name="DiscountType"
                   id="DiscountAmount"
                   value="amount">

            <label class="form-check-label" for="DiscountAmount">
                مبلغی
            </label>

        </div>

        <div class="form-check">

            <input class="form-check-input"
                   type="radio"
                   name="DiscountType"
                   id="DiscountPercentage"
                   value="percentage">

            <label class="form-check-label" for="DiscountPercentage">
                درصدی
            </label>

        </div>

    </div>

</div>

                <div class="form-group">
                    <label>مبلغ تخفیف</label>
                    <input type="number"
                           id="EditAmount"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>درصد تخفیف</label>
                    <input type="number"
                           id="EditPercentage"
                           class="form-control" />
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-success"
                        onclick="UpdateDiscount()">
                    ذخیره
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    انصراف
                </button>

            </div>

        </div>

    </div>

</div>


}